<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="TeatroPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Classes Entidades Mapeadas -->
        <class>br.com.gerenciamentoteatro.model.Administrador</class>
        <class>br.com.gerenciamentoteatro.model.RegraPreco</class>
        <class>br.com.gerenciamentoteatro.model.Artista</class>
        <class>br.com.gerenciamentoteatro.model.Cliente</class>
        <class>br.com.gerenciamentoteatro.model.Peca</class>
        <class>br.com.gerenciamentoteatro.model.PropostaAluguel</class>
        <class>br.com.gerenciamentoteatro.model.ContratoAluguel</class>
        <class>br.com.gerenciamentoteatro.model.Ingresso</class>

        <properties>
            <!-- Configuração JDBC H2 (Modo Arquivo Persistente) -->
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>

            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:./banco_teatro;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- Dialeto Hibernate & Criação Automática de Tabelas -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>